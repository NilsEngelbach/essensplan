# Settings for ./deploy.sh. Copy to .env.deploy (never committed) and fill in.
# Values are taken literally: no escaping, optional surrounding quotes are stripped.

# all-inkl KAS → FTP: server, user and password. Best an extra FTP user limited to the app
# folder (KAS → FTP → "FTP-Zugang anlegen", Verzeichnis /essensplan), then DEPLOY_PATH=/.
# The connection always uses TLS (FTP über SSL/TLS).
DEPLOY_HOST=w0000000.kasserver.com
DEPLOY_PORT=21
DEPLOY_USER=
DEPLOY_PASS=

# Target folder for the app, as an absolute FTP path. / when the FTP user is limited to the
# app folder, otherwise e.g. /essensplan. The domain must point at <DEPLOY_PATH>/public.
# The script refuses a folder that is neither empty nor this app.
DEPLOY_PATH=/

# The live address: migrations and console commands go to <DEPLOY_URL>/ops, and after each
# deploy the script checks version.txt and /api/v1/health there.
DEPLOY_URL=https://essen.example.de

# Same value as OPS_TOKEN in the server's config.php (at least 32 characters):
#   php -r "echo bin2hex(random_bytes(24));"
DEPLOY_OPS_TOKEN=

# The server's settings (never committed; template config.production.example.php). They go up
# as config.php with ./deploy.sh --push-config.
DEPLOY_CONFIG_FILE=config.production.php

# Parallel FTP connections for uploads (all-inkl allows several per user).
DEPLOY_PARALLEL=4

# Optional: PHP and composer.phar for the build. Default: Local's PHP and its bundled Composer,
# else php/composer from PATH.
DEPLOY_PHP=
DEPLOY_COMPOSER=

# Optional: which curl to use. Default: the newer of Git Bash's and Windows' own
# (C:\Windows\System32\curl.exe). Git Bash's curl 8.10 broke FTPS uploads on all-inkl.
DEPLOY_CURL=
# Optional: highest TLS version for FTP, e.g. 1.2 if uploads still end in 426 / partial files.
DEPLOY_TLS_MAX=

# ── SSH (recommended when the plan has it) ───────────────────────────────────
# With DEPLOY_SSH set, deploy.sh skips FTP: the build goes up as one archive through one ssh
# connection, is swapped in on the server, and bin/console migrates there. --console then runs
# over SSH with every command. DEPLOY_HOST/USER/PASS/PATH are not needed in this mode;
# DEPLOY_URL (and DEPLOY_OPS_TOKEN for --check) still are.
# An SSH key saves typing the password: ssh-keygen -t ed25519, then append ~/.ssh/id_ed25519.pub
# to ~/.ssh/authorized_keys on the server.
DEPLOY_SSH=
DEPLOY_SSH_PORT=22
# Absolute path of the app folder on the server (the domain points at its public/ subfolder).
# all-inkl: /www/htdocs/w0…/essensplan. After logging in, pwd and ls show it.
DEPLOY_SSH_PATH=
# The server's PHP command line: at least 8.2 with pdo_mysql. If `php -v` shows an older one,
# use the versioned command (all-inkl: e.g. php82 or php83).
DEPLOY_SSH_PHP=php
