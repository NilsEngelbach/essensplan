#!/usr/bin/env php
<?php

declare(strict_types=1);

// php bin/console <command> [--option=value …]   (the commands are in src/Console/Console.php)

use Essensplan\App;
use Essensplan\Config;
use Essensplan\Console\Console;
use Essensplan\Http\ApiError;

require dirname(__DIR__) . '/vendor/autoload.php';

date_default_timezone_set('UTC');

$config = Config::load(App::root());
$console = new Console(App::container($config), $config);

try {
    $console->run($argv[1] ?? 'help', Console::parse(array_slice($argv, 2)), function (string $s): void {
        fwrite(STDOUT, $s . PHP_EOL);
    });
} catch (ApiError $e) {
    fwrite(STDERR, $e->getMessage() . PHP_EOL);
    exit(1);
} catch (Throwable $e) {
    fwrite(STDERR, ($e instanceof Essensplan\Console\ConsoleError ? '' : $e::class . ': ') . $e->getMessage() . PHP_EOL);
    exit(1);
}
