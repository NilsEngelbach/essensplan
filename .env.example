# ----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://...supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Required by the Supabase edge functions (set via `supabase secrets set ...`)
SUPABASE_URL="https://...supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# ----------------------------------------------------------------------------
# AI feature switch
# ----------------------------------------------------------------------------
# AI_PROVIDER controls which AI backend the edge functions use.
# Values: "openai" | "opencode". Defaults to "opencode" when unset.
AI_PROVIDER="opencode"

# Public mirror of AI_PROVIDER, read by the Next.js frontend to hide AI
# features that are not supported by the active provider (e.g. image
# enhancement). Must mirror AI_PROVIDER.
NEXT_PUBLIC_AI_PROVIDER="opencode"

# ----------------------------------------------------------------------------
# OpenCode Go credentials (used when AI_PROVIDER=opencode)
# ----------------------------------------------------------------------------
# Get your key from https://opencode.ai/auth after subscribing to OpenCode Go.
OPENCODE_API_KEY=""
# Default model to use for recipe import. See https://opencode.ai/docs/de/go/
# for the full list (e.g. glm-5.2, kimi-k3, deepseek-v4-pro, deepseek-v4-flash).
OPENCODE_MODEL="glm-5.2"
# Model used for screenshot imports (must support vision/image input).
# Falls back to OPENCODE_MODEL when unset.
OPENCODE_IMAGE_MODEL="kimi-k3"

# ----------------------------------------------------------------------------
# OpenAI credentials (used when AI_PROVIDER=openai)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=""
# Optional override for the OpenAI model used by ai-import.
OPENAI_MODEL="gpt-5-mini"

# ============================================================================
# New PHP backend (Slim 4 + MySQL, docs/MIGRATION_PLAN.md). Read from .env by
# the PHP app locally (on the server: config.php, see config.production.example.php);
# the Next.js app above stays until cutover.
# ============================================================================
APP_ENV=local                 # local | production
APP_URL=http://essen.local
# Random, at least 32 characters: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
APP_DEBUG=

DB_HOST=127.0.0.1
DB_PORT=10029
DB_NAME=essensplan
DB_USER=root
DB_PASS=root

# log (storage/mail.log) | smtp (Mailpit locally, all-inkl SMTP in production)
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=essensplan@essen.local

# No sign-up over HTTP (D10, D20): families are added with bin/console user:create.
# "Angemeldet bleiben" off: the session ends after this many idle hours (and with the browser).
SESSION_IDLE_HOURS=12
# Comma-separated proxy IPs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=
RATE_LIMIT_KEY=120
RATE_LIMIT_IP=300

# AI import (Phase 6, BACKEND_REQUIREMENTS §4.7). The PHP app reads the same
# AI_PROVIDER, OPENCODE_* and OPENAI_* as the old app above, plus:
#   AI_PROVIDER = opencode (default) | anthropic | openai
# Without the chosen provider's key the import is off ("selbst eingeben").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OPENAI_EFFORT=low
# Seconds per model call, and imports per family and hour.
AI_TIMEOUT=150
AI_IMPORTS_PER_HOUR=30

# Photos live outside the docroot and are served to their family only
# (default storage/media).
MEDIA_DIR=

# Operator door for hosts without SSH (deploy.sh, docs/DEPLOY.md). At least 32
# characters each; empty switches the door off. php -r "echo bin2hex(random_bytes(24));"
#   OPS_TOKEN:  POST /ops/migrate|check|console with header X-Ops-Token
#   CRON_TOKEN: GET /cron?token=… for the hosting's cron (import leftovers + purge)
OPS_TOKEN=
CRON_TOKEN=
# Phase 8 importer (bin/console import:supabase): the old Supabase Postgres URL.
# Empty = DIRECT_URL above. Needs pdo_pgsql (Local: extension=php_pdo_pgsql.dll).
SUPABASE_DB_URL=
