# Local settings for the PHP app. Copy to .env (never committed) and fill in.
# On the server the app reads config.php instead (template: config.production.example.php).
# Real environment variables fill in whatever this file leaves out.

APP_ENV=local                 # local | production
APP_URL=http://essen.local
# Random, at least 32 characters: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
# Empty = on unless APP_ENV is production.
APP_DEBUG=

# MySQL 8 (MariaDB is not supported). Local shows host, port and login under Database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=essensplan
DB_USER=root
DB_PASS=root

# log (writes storage/mail.log) | smtp (Local's Mailpit; its SMTP port is under Tools → Mailpit)
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=
MAIL_FROM=essensplan@essen.local

# "Angemeldet bleiben" off: the session ends after this many idle hours (and with the browser).
SESSION_IDLE_HOURS=12
# Comma-separated proxy IPs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=
# Requests per minute per API key and per IP without a key.
RATE_LIMIT_KEY=120
RATE_LIMIT_IP=300

# Photos live outside the docroot and are served to their family only. Empty = storage/media.
MEDIA_DIR=

# AI import (optional): every provider with a key below is configured. None (or
# AI_PROVIDER=off) turns the import off and the app only offers "selbst eingeben".
# AI_PROVIDER names the default: opencode | anthropic | openai. With several keys set,
# each family picks one in Konto.
AI_PROVIDER=opencode
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.2
OPENCODE_IMAGE_MODEL=kimi-k3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EFFORT=low
# Seconds per model call, and imports per family and hour.
AI_TIMEOUT=150
AI_IMPORTS_PER_HOUR=30

# The hosting's URL cron: GET /cron?token=… (import leftovers + purge). At least 32 characters;
# empty switches /cron off. Locally you can run `php bin/console cron` instead.
CRON_TOKEN=
