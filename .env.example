# ----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://...supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Required by the Supabase edge functions (set via `supabase secrets set ...`)
SUPABASE_URL="https://...supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# ----------------------------------------------------------------------------
# AI feature switch
# ----------------------------------------------------------------------------
# AI_PROVIDER controls which AI backend the edge functions use.
# Values: "openai" | "opencode". Defaults to "opencode" when unset.
AI_PROVIDER="opencode"

# Public mirror of AI_PROVIDER, read by the Next.js frontend to hide AI
# features that are not supported by the active provider (e.g. image
# enhancement). Must mirror AI_PROVIDER.
NEXT_PUBLIC_AI_PROVIDER="opencode"

# ----------------------------------------------------------------------------
# OpenCode Go credentials (used when AI_PROVIDER=opencode)
# ----------------------------------------------------------------------------
# Get your key from https://opencode.ai/auth after subscribing to OpenCode Go.
OPENCODE_API_KEY=""
# Default model to use for recipe import. See https://opencode.ai/docs/de/go/
# for the full list (e.g. glm-5.2, kimi-k3, deepseek-v4-pro, deepseek-v4-flash).
OPENCODE_MODEL="glm-5.2"
# Model used for screenshot imports (must support vision/image input).
# Falls back to OPENCODE_MODEL when unset.
OPENCODE_IMAGE_MODEL="kimi-k3"

# ----------------------------------------------------------------------------
# OpenAI credentials (used when AI_PROVIDER=openai)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=""
# Optional override for the OpenAI model used by ai-import.
OPENAI_MODEL="gpt-5-mini"

# ============================================================================
# New PHP backend (Slim 4 + MySQL, docs/MIGRATION_PLAN.md). Read from .env by
# the PHP app; the Next.js app above stays until cutover.
# ============================================================================
APP_ENV=local                 # local | production
APP_URL=http://essen.local
# Random, at least 32 characters: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
APP_DEBUG=

DB_HOST=127.0.0.1
DB_PORT=10029
DB_NAME=essensplan
DB_USER=root
DB_PASS=root

# log (storage/mail.log) | smtp (Mailpit locally, all-inkl SMTP in production)
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=essensplan@essen.local

# Family app (D10): no open sign-up once the owner exists.
REGISTRATION_ENABLED=false
# "Angemeldet bleiben" off: the session ends after this many idle hours (and with the browser).
SESSION_IDLE_HOURS=12
# Comma-separated proxy IPs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=
RATE_LIMIT_KEY=120
RATE_LIMIT_IP=300

# AI in PHP (Phase 6, unused in this draft). At cutover AI_PROVIDER above
# becomes openai | anthropic | opencode; OPENAI_* and OPENCODE_* are shared.
AI_IMAGE_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OPENAI_IMAGE_MODEL=gpt-image-1
