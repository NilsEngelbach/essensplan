{
    "name": "essensplan/backend",
    "description": "Essensplan backend: REST API, MCP server and SPA host (Slim 4, MySQL)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "opis/json-schema": "^2.4",
        "guzzlehttp/guzzle": "^7.9",
        "anthropic-ai/sdk": "^1.6",
        "mcp/sdk": "^0.9",
        "intervention/image": "^3.11"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Essensplan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Essensplan\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.29"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
